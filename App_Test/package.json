{
  "name": "brasov-sunset-api-tests",
  "version": "1.0.0",
  "description": "Unit/integration tests for Brasov Sunset API",
  "scripts": {
    "test": "jest --verbose",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit"
  },
  "jest": {
    "collectCoverageFrom": [
      "../App/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "statements": 80,
        "branches": 70,
        "functions": 80
      }
    }
  },
  "jest-junit": {
    "outputDirectory": "./reports",
    "outputName": "junit.xml"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  },
  "dependencies": {
    "brasov-sunset-api": "file:../App",
    "suncalc": "^1.9.0",
    "express": "^4.19.2"
  }
}
